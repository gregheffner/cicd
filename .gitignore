# macOS
.DS_Store

# Secrets / credentials — never commit
.env
.env.*
*.pem
*.key
*.p12
credentials
id_rsa*
kubeconfig
*.kubeconfig

# Vendored radar app — secrets stay local, only the example env ships
weathermap/app/.env*
!weathermap/app/.env.example
weathermap/app/*.key
weathermap/app/*.cert
weathermap/app/*.pem
weathermap/app/node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.testvenv/

# Logs / temp
*.log
tmp.yaml

# Editor / tooling
.vscode/
.github/instructions/
graphify-out/

# Private operator runbook + internal design docs (never publish — internal topology)
ops-local/

# Claude Code session settings, local only
.claude/
